# ~/.config/kitty/kitty.conf

# === Renderização / Performance ===
repaint_delay 8
input_delay 2
sync_to_monitor yes
# wayland_titlebar_color system

# Sem GPU dedicada — evita overhead de composição em Wayland puro
linux_display_server auto

# === Fonte ===
font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 11.0
disable_ligatures never
font_features none

# === Cursor ===
cursor_shape block
cursor_blink_interval 0
cursor_stop_blinking_after 0

# === Scrollback ===
scrollback_lines 10000
scrollback_pager_history_size 0

# === Janela ===
remember_window_size  yes
initial_window_width  120c
initial_window_height 32c
window_padding_width 4
hide_window_decorations no
draw_minimal_borders yes
window_border_width 1pt
placement_strategy center

# === Tabs (estilo, leve) ===
tab_bar_edge bottom
tab_bar_style powerline
tab_powerline_style slanted
tab_title_template "{index}: {title}"

# === Mouse ===
mouse_hide_wait 3.0
copy_on_select yes
strip_trailing_spaces smart

# === Terminal / shell ===
shell_integration enabled
allow_remote_control yes
listen_on unix:@mykitty
close_on_child_death no
confirm_os_window_close 0

# === Notificações (integração KDE) ===
notify_on_cmd_finish invisible 5.0 notify

# === Áudio ===
enable_audio_bell no
visual_bell_duration 0.0

# === URL ===
detect_urls yes
url_style curly

# === Layouts (produtividade) ===
enabled_layouts tall,fat,grid,horizontal,vertical,splits
# active_border_color #89b4fa
# inactive_border_color #45475a

# === Atalhos extras úteis ===
map ctrl+shift+enter launch --cwd=current
map ctrl+shift+z toggle_layout stack
map ctrl+shift+f5 load_config_file
map ctrl+shift+equal change_font_size all +1.0
map ctrl+shift+minus change_font_size all -1.0
map ctrl+shift+backspace change_font_size all 0

# === Tema (exemplo — troque se usar outro) ===
include current-theme.conf


# BEGIN_KITTY_THEME
# One Half Dark
# END_KITTY_THEME